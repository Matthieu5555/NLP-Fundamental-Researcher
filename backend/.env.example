# FastAPI Configuration
FASTAPI_ENV=development
PORT=5001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenRouter API (for LLM)
OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Google Gemini API (for search grounding)
# Get your key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional Data APIs
ALPHA_VANTAGE_API_KEY=
EODHD_API_KEY=

# FinancialDatasets.ai API (for US company data)
# Get your key from: https://financialdatasets.ai
# Required for: detailed financials, insider trades, analyst estimates
FDS_API_KEY=

# Data directories
DATA_DIR=../data
EMBEDDINGS_DIR=../embeddings

# RAG Configuration
CHUNK_SIZE=1000
MAX_DEBATE_ROUNDS=2

# Session Management
SESSION_TIMEOUT_HOURS=24

# Authentication (JWT)
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-this-to-a-strong-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
